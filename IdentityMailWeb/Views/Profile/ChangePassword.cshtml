@model ChangePasswordDto

@{
    Layout = "_MailLayout";
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="max-w-3xl">
    <div class="flex justify-between items-center mb-6">
        <h2 class="font-headline-md text-headline-md text-on-surface">Şifre Değiştir</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-tertiary-container text-on-tertiary-container font-body-sm px-4 py-3 rounded-lg mb-4">@TempData["SuccessMessage"]</div>
    }

    <div class="bg-surface rounded-xl shadow-sm border border-outline-variant p-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-error font-body-sm mb-2"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="CurrentPassword" class="block font-label-md text-label-md text-on-surface mb-1">Mevcut Şifre</label>
                    <input asp-for="CurrentPassword" class="w-full bg-surface-container-low border border-outline-variant rounded-lg py-2 px-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-sm text-body-sm" />
                    <span asp-validation-for="CurrentPassword" class="text-error font-body-sm"></span>
                </div>
                <div>
                    <label asp-for="NewPassword" class="block font-label-md text-label-md text-on-surface mb-1">Yeni Şifre</label>
                    <input asp-for="NewPassword" class="w-full bg-surface-container-low border border-outline-variant rounded-lg py-2 px-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-sm text-body-sm" />
                    <span asp-validation-for="NewPassword" class="text-error font-body-sm"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block font-label-md text-label-md text-on-surface mb-1">Yeni Şifre Tekrar</label>
                    <input asp-for="ConfirmPassword" class="w-full bg-surface-container-low border border-outline-variant rounded-lg py-2 px-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-sm text-body-sm" />
                    <span asp-validation-for="ConfirmPassword" class="text-error font-body-sm"></span>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-outline-variant">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg font-label-sm text-label-sm hover:bg-primary-fixed-dim transition-colors">
                    <span class="material-symbols-outlined text-sm" data-icon="lock">lock</span>
                    Şifreyi Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
