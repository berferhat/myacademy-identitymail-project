@model ForgotPasswordDto

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifremi Unuttum";
}

<main class="flex-grow flex items-center justify-center p-container-padding-mobile md:p-container-padding-desktop">
    <div class="w-full max-w-[480px] bg-surface-container-lowest rounded-xl shadow-soft-level-1 border border-surface-variant p-8 md:p-10 relative overflow-hidden">

        <div class="flex flex-col items-center mb-8 text-center">
            <span class="material-symbols-outlined text-primary text-5xl mb-4" data-icon="lock_reset">lock_reset</span>
            <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">
                Şifremi Unuttum
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant">E-posta adresinizi girin, sıfırlama bağlantısı oluşturulsun.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-tertiary-container text-on-tertiary-container font-body-sm px-4 py-3 rounded-lg mb-4 text-center">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ResetLink"] != null)
        {
            <div class="bg-primary-fixed text-on-primary-fixed font-body-sm px-4 py-3 rounded-lg mb-4 text-center">
                <p class="mb-2">Öğrenci projesi: Gerçek e-posta yok, bağlantı aşağıda.</p>
                <a href="@TempData["ResetLink"]" class="font-label-md text-label-md text-primary hover:text-primary-container transition-colors underline">Şifreyi Sıfırla</a>
            </div>
        }

        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-error font-body-sm"></div>

            <div>
                <label asp-for="Email" class="block font-label-md text-label-md text-on-surface mb-2">E-posta Adresiniz</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 transform -translate-y-1/2 text-outline">mail</span>
                    <input asp-for="Email" class="w-full pl-10 pr-4 py-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:outline-none input-glow transition-all duration-200 font-body-md text-body-md" placeholder="ornek@alanadi.com" type="email" />
                </div>
                <span asp-validation-for="Email" class="text-error font-body-sm"></span>
            </div>

            <button type="submit" class="w-full bg-brand-gradient text-on-primary py-3 px-4 rounded-lg font-label-md text-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-200 shadow-sm flex items-center justify-center gap-2">
                Sıfırlama Bağlantısı Oluştur
                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
            </button>
        </form>

        <div class="mt-8 text-center border-t border-surface-variant pt-6">
            <p class="font-body-sm text-body-sm text-on-surface-variant">
                Şifreni hatırladın mı?
                <a asp-controller="Auth" asp-action="Login" class="font-label-md text-label-md text-primary hover:text-primary-container transition-colors ml-1">Giriş Yap</a>
            </p>
        </div>
    </div>
</main>