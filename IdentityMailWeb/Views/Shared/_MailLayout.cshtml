@using Microsoft.AspNetCore.Identity
@using IdentityMail.Web.Entities
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : User.Identity?.Name;

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var navActive = "flex items-center px-4 py-3 bg-primary-container text-on-primary-container font-label-md text-label-md rounded-lg transition-all duration-200 ease-in-out";
    var navDefault = "flex items-center px-4 py-3 text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md rounded-lg transition-all duration-200 ease-in-out";
}



<!DOCTYPE html>

<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>IdentityMail - Gelen Kutusu</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&amp;display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
          rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-surface": "#191c1e",
                        "error-container": "#ffdad6",
                        "primary-container": "#007bb9",
                        "inverse-primary": "#93ccff",
                        "surface-bright": "#f7f9fb",
                        "primary": "#006194",
                        "surface-container": "#eceef0",
                        "surface": "#f7f9fb",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#e0e3e5",
                        "on-primary": "#ffffff",
                        "primary-fixed": "#cce5ff",
                        "outline": "#707881",
                        "on-tertiary-fixed": "#00201d",
                        "secondary-fixed-dim": "#bec6e0",
                        "surface-container-high": "#e6e8ea",
                        "surface-variant": "#e0e3e5",
                        "on-secondary-fixed-variant": "#3f465c",
                        "surface-container-low": "#f2f4f6",
                        "on-secondary": "#ffffff",
                        "tertiary-fixed": "#89f5e7",
                        "tertiary-fixed-dim": "#6bd8cb",
                        "on-primary-container": "#fdfcff",
                        "on-tertiary-container": "#f4fffc",
                        "surface-tint": "#006398",
                        "secondary-fixed": "#dae2fd",
                        "tertiary": "#00685f",
                        "surface-dim": "#d8dadc",
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#001d31",
                        "on-surface-variant": "#3f4850",
                        "inverse-surface": "#2d3133",
                        "primary-fixed-dim": "#93ccff",
                        "inverse-on-surface": "#eff1f3",
                        "on-primary-fixed-variant": "#004b73",
                        "on-background": "#191c1e",
                        "error": "#ba1a1a",
                        "secondary": "#565e74",
                        "secondary-container": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "background": "#f7f9fb",
                        "on-secondary-fixed": "#131b2e",
                        "outline-variant": "#bfc7d2",
                        "tertiary-container": "#008378",
                        "on-secondary-container": "#5c647a",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed-variant": "#005049"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "unit": "8px",
                        "stack-md": "1rem",
                        "stack-sm": "0.5rem",
                        "stack-lg": "2rem",
                        "container-padding-desktop": "2.5rem",
                        "container-padding-mobile": "1rem",
                        "gutter": "1.5rem"
                    },
                    "fontFamily": {
                        "headline-sm": ["Montserrat"],
                        "label-md": ["Montserrat"],
                        "headline-md": ["Montserrat"],
                        "label-sm": ["Montserrat"],
                        "headline-lg": ["Montserrat"],
                        "body-lg": ["Montserrat"],
                        "headline-lg-mobile": ["Montserrat"],
                        "display-lg": ["Montserrat"],
                        "body-md": ["Montserrat"],
                        "body-sm": ["Montserrat"]
                    },
                    "fontSize": {
                        "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "500" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "700" }],
                        "display-lg": ["48px", { "lineHeight": "60px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f8fafc;
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>

<body class="font-body-md text-on-surface bg-background flex h-screen overflow-hidden">
    <!-- SideNavBar -->
    <aside class="hidden md:flex flex-col h-screen p-stack-md w-64 bg-surface-container-low border-r border-outline-variant transition-all duration-200 ease-in-out shrink-0 z-10">
        <div class="flex items-center mb-stack-lg px-2">
            <span class="material-symbols-outlined text-primary text-3xl mr-3" data-icon="shield">shield</span>
            <div>
                <h1 class="font-headline-sm text-headline-sm font-bold text-primary">IdentityMail</h1>
                <p class="font-label-sm text-label-sm text-on-surface-variant">Kurumsal İletişim</p>
            </div>
        </div>
        <a asp-controller="Message" asp-action="SendMail"
           class="w-full mb-stack-lg bg-gradient-to-b from-[#0284c7] to-[#0369a1] hover:from-[#0369a1] hover:to-[#0284c7] text-white font-label-md text-label-md py-3 rounded-lg flex items-center justify-center gap-2 shadow-sm transition-colors duration-200">
            <span class="material-symbols-outlined" data-icon="edit">edit</span>
            Yeni Mesaj
        </a>
        <nav class="flex-1 space-y-1">
            <a class="@(currentController == "Message" && currentAction == "Index" ? navActive : navDefault)" href="/Message/Index">
                <span class="material-symbols-outlined mr-3" data-icon="inbox">inbox</span>
                Gelen Kutusu
                <span class="ml-auto bg-primary text-on-primary text-xs font-bold px-2 py-0.5 rounded-full">@await Component.InvokeAsync("UnreadMessageCount")</span>
            </a>
            <a class="@(currentController == "Message" && currentAction == "Sent" ? navActive : navDefault)" href="/Message/Sent">
                <span class="material-symbols-outlined mr-3" data-icon="send">send</span>
                Gönderilmiş
            </a>
            <a class="@(currentController == "Message" && currentAction == "Drafts" ? navActive : navDefault)" href="/Message/Drafts">
                <span class="material-symbols-outlined mr-3" data-icon="draft">draft</span>
                Taslaklar
            </a>
            <a class="@(currentController == "Message" && currentAction == "Important" ? navActive : navDefault)" href="/Message/Important">
                <span class="material-symbols-outlined mr-3" data-icon="star">star</span>
                Önemli
            </a>
            <a class="@(currentController == "Message" && currentAction == "Trash" ? navActive : navDefault)" href="/Message/Trash">
                <span class="material-symbols-outlined mr-3" data-icon="delete">delete</span>
                Çöp Kutusu
            </a>
            <a class="@(currentController == "Category" ? navActive : navDefault)" href="/Category/Index">
                <span class="material-symbols-outlined mr-3" data-icon="label">label</span>
                Kategoriler
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="@(currentController == "Admin" ? navActive : navDefault)" asp-controller="Admin" asp-action="Index">
                    <span class="material-symbols-outlined mr-3" data-icon="admin_panel_settings">admin_panel_settings</span>
                    Admin Paneli
                </a>
            }
        </nav>
        <div class="mt-auto pt-4 border-t border-outline-variant space-y-1">
            <a asp-controller="Profile" asp-action="Index" class="flex items-center px-4 py-3 text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md rounded-lg transition-all duration-200 ease-in-out">
                <span class="material-symbols-outlined mr-3" data-icon="person">person</span>
                Profilim
            </a>
            <a asp-controller="Profile" asp-action="ChangePassword" class="flex items-center px-4 py-3 text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md rounded-lg transition-all duration-200 ease-in-out">
                <span class="material-symbols-outlined mr-3" data-icon="lock">lock</span>
                Şifre Değiştir
            </a>
            <a asp-controller="Auth" asp-action="Logout" class="flex items-center px-4 py-3 text-on-surface-variant hover:bg-surface-container-high font-label-md text-label-md rounded-lg transition-all duration-200 ease-in-out">
                <span class="material-symbols-outlined mr-3" data-icon="logout">logout</span>
                Çıkış Yap
            </a>
        </div>
    </aside>
    <div class="flex-1 flex flex-col min-w-0">
        <!-- TopNavBar -->
        <header class="flex justify-between items-center px-container-padding-desktop w-full h-16 bg-surface border-b border-outline-variant shadow-sm transition-colors duration-200 z-10 shrink-0">
            <div class="flex items-center flex-1">
                <!-- Mobile Menu Button -->
                <button class="md:hidden mr-4 text-on-surface-variant hover:bg-surface-container-low p-2 rounded-full transition-colors">
                    <span class="material-symbols-outlined" data-icon="menu">menu</span>
                </button>
                <div class="relative w-full max-w-md hidden md:block">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 transform -translate-y-1/2 text-on-surface-variant"
                          data-icon="search">search</span>
                    <input class="w-full bg-surface-container-low border border-outline-variant rounded-full py-2 pl-10 pr-4 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-sm text-body-sm placeholder:text-on-surface-variant transition-all"
                           placeholder="E-postalarda ara..." type="text" />
                </div>
            </div>
            <div class="flex items-center gap-4">
                <button class="text-on-surface-variant hover:bg-surface-container-low p-2 rounded-full transition-colors relative">
                    <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"></span>
                </button>
                <div class="h-6 w-px bg-outline-variant mx-2"></div>
                <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 cursor-pointer group">
                    <div class="text-right hidden sm:block">
                        <div class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors">
                            @displayName
                        </div>
                        <div class="font-label-sm text-label-sm text-on-surface-variant">Profilim</div>
                    </div>
                    @if (!string.IsNullOrEmpty(currentUser?.ProfileImageUrl))
                    {
                        <img class="w-10 h-10 rounded-full border border-outline-variant object-cover"
                             src="@currentUser.ProfileImageUrl" alt="Profil" />
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-full border border-outline-variant bg-primary-container flex items-center justify-center text-on-primary-container font-label-md">
                            @(displayName?.Substring(0, 1))
                        </div>
                    }
                </a>
            </div>
        </header>
        <!-- Main Content (Inbox List) -->
        <main class="flex-1 overflow-y-auto p-4 md:p-container-padding-desktop">
            @RenderBody()
        </main>
    </div>
    <!-- BottomNavBar (Mobile Only) -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full flex justify-around items-center px-4 py-2 bg-surface border-t border-outline-variant shadow-lg z-50">
        <a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl px-3 py-1 scale-95 transition-transform"
           href="#">
            <span class="material-symbols-outlined text-lg mb-0.5" data-icon="inbox">inbox</span>
            <span class="font-label-sm text-[10px]">Gelen</span>
        </a>
        <a class="flex flex-col items-center justify-center text-on-surface-variant active:bg-surface-container px-3 py-1 rounded-xl transition-colors"
           href="#">
            <span class="material-symbols-outlined text-lg mb-0.5" data-icon="send">send</span>
            <span class="font-label-sm text-[10px]">Gönder</span>
        </a>
        <a class="flex flex-col items-center justify-center text-on-surface-variant active:bg-surface-container px-3 py-1 rounded-xl transition-colors"
           href="#">
            <span class="material-symbols-outlined text-lg mb-0.5" data-icon="star">star</span>
            <span class="font-label-sm text-[10px]">Yıldızlı</span>
        </a>
        <a class="flex flex-col items-center justify-center text-on-surface-variant active:bg-surface-container px-3 py-1 rounded-xl transition-colors"
           href="#">
            <span class="material-symbols-outlined text-lg mb-0.5" data-icon="menu">menu</span>
            <span class="font-label-sm text-[10px]">Menü</span>
        </a>
    </nav>
</body>

</html>